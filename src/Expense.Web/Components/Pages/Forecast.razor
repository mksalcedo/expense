@page "/forecast"
@using Expense.Domain.Entities
@using Expense.Domain.Services.Forecast
@inject IForecastResultProvider ForecastResultProvider
@inject IJSRuntime JS

<PageTitle>Forecast</PageTitle>

<h1>Forecast</h1>

@if (_result is null)
{
    <p>Loading...</p>
}
else
{
    <p>Starting balance: @_result.StartingBalance.ToString("N2")</p>
    <p>
        Lowest projected balance: @_result.LowestProjectedBalance.ToString("N2")
        @if (_result.LowestProjectedBalanceDate is { } lowestDate)
        {
            <text> (Occurs on @lowestDate.ToString("MM/dd/yyyy"))</text>
        }
    </p>
    <p><a id="export-excel-link" href="/export/forecast.xlsx" target="_blank">Export to Excel</a></p>

    <p>
        <label>
            <input id="show-resolved-toggle" type="checkbox" checked="@_showResolved" @onchange="ToggleShowResolvedAsync" />
            Show resolved items (paid, overridden, or auto-reconciled)
        </label>
    </p>

    <table id="ledger-table" style="border-collapse: collapse">
        <thead>
            <tr>
                <th style="@CellStyle()">Date</th>
                <th style="@CellStyle()">Description</th>
                <th style="@CellStyle(rightAlign: true)">Amount</th>
                <th style="@CellStyle(rightAlign: true)">Running balance</th>
                <th style="@CellStyle()">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (row, index) in _result.Rows.Where(r => _showResolved || !r.IsExcluded).Select((r, i) => (r, i)))
            {
                <tr style="@RowStyle(row)">
                    <td style="@CellStyle()">@row.Date.ToString("MM/dd/yyyy")</td>
                    <td style="@CellStyle()">
                        @row.Description
                        @if (row.IsExcluded)
                        {
                            <br />
                            <span style="color: #666">(@row.ExclusionReason)</span>
                        }
                        else
                        {
                            @if (row.IsDeferred)
                            {
                                <br />
                                <span style="color: red">
                                    &#9888; Originally estimated for @row.OriginalDate.ToString("MM/dd/yyyy") - remember to manually
                                    reschedule this payment for real.
                                </span>
                            }
                            @if (row.SuggestedOverrideAmount is { } suggestedAmount)
                            {
                                <br />
                                <span id="near-miss-note-@index" style="color: #0969da">
                                    A @suggestedAmount.ToString("N2") transaction was found nearby (posted @row.SuggestedOverrideDate!.Value.ToString("MM/dd/yyyy")) -
                                    review with Change Amount.
                                </span>
                            }
                        }
                        @foreach (var partialPayment in row.PartialPayments)
                        {
                            <br />
                            <span style="color: #555">
                                @(IsIncomeLine(row) ? "Received" : "Paid") $@partialPayment.Amount.ToString("N2") on @partialPayment.PaidDate.ToString("MM/dd/yyyy")
                                <button id="undo-partial-payment-btn-@partialPayment.PartialPaymentId" @onclick="() => OpenUndoPartialPaymentModal(row, partialPayment)">Undo</button>
                            </span>
                        }
                    </td>
                    <td style="@CellStyle(rightAlign: true)">@row.Amount.ToString("N2")</td>
                    <td style="@CellStyle(rightAlign: true)">@row.RunningBalance.ToString("N2")</td>
                    <td style="@CellStyle()">
                        @if (row.IsExcluded && row.ConfirmationId is not null)
                        {
                            <button id="undo-confirmation-btn-@row.ConfirmationId" @onclick="() => OpenUndoConfirmationModal(row)">Undo</button>
                        }
                        else if (!row.IsExcluded)
                        {
                            <div style="display: flex; align-items: center; gap: 8px;">
                                @if (row.IsDeferred)
                                {
                                    <button id="remove-deferral-btn-@index" title="Remove deferral" @onclick="() => OpenRemoveDeferralModal(row)">&#8617;</button>
                                }
                                else
                                {
                                    <button id="defer-btn-@index" title="Defer..." @onclick="() => OpenDeferModal(row)">&#128337;</button>
                                }
                                <button id="confirm-btn-@index" title="Confirm paid" @onclick="() => OpenConfirmModal(row)">&#10003;</button>
                                <button id="override-btn-@index" title="Change amount" @onclick="() => OpenOverrideModal(row)">&#8644;</button>
                                <button id="partial-pay-btn-@index" title="@(IsIncomeLine(row) ? "Record partial income" : "Pay partial amount")" @onclick="() => OpenPayPartialModal(row)">&#128176;</button>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (_activeModal != ModalKind.None)
    {
        <div id="action-modal-backdrop" style="position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 1000;">
            <div id="action-modal" style="background: var(--color-bg, white); padding: 1.5em; border-radius: 8px; max-width: 420px; box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
                <h3 id="action-modal-title" style="margin-top: 0;">@ModalTitle()</h3>
                <p id="action-modal-explanation">@ModalExplanation()</p>
                @if (_activeModal == ModalKind.Defer)
                {
                    <div class="detail-form">
                        <label for="modal-date-input">New date</label>
                        <input id="modal-date-input" type="date" value="@_modalDate.ToString("yyyy-MM-dd")"
                               @onchange="e => _modalDate = DateOnly.Parse((string)e.Value!)" />
                    </div>
                }
                else if (_activeModal == ModalKind.PayPartial)
                {
                    <div class="detail-form">
                        <label for="modal-amount-input">Amount</label>
                        <input id="modal-amount-input" type="number" step="0.01" value="@_modalAmount"
                               @onchange="e => _modalAmount = ParseNullableDecimal((string)e.Value!)" />
                        <label for="modal-date-input">@(_modalRow is not null && IsIncomeLine(_modalRow) ? "Date received" : "Date paid")</label>
                        <input id="modal-date-input" type="date" value="@_modalDate.ToString("yyyy-MM-dd")"
                               @onchange="e => _modalDate = DateOnly.Parse((string)e.Value!)" />
                    </div>
                }
                else if (_activeModal == ModalKind.Override)
                {
                    <div class="detail-form">
                        <label for="modal-amount-input">Amount</label>
                        <input id="modal-amount-input" type="number" step="0.01" value="@_modalAmount"
                               @onchange="e => _modalAmount = ParseNullableDecimal((string)e.Value!)" />
                        <label for="modal-date-input">Date</label>
                        <input id="modal-date-input" type="date" value="@_modalDate.ToString("yyyy-MM-dd")"
                               @onchange="e => _modalDate = DateOnly.Parse((string)e.Value!)" />
                    </div>
                }
                <div class="button-row" style="margin-top: 1em;">
                    <button id="action-modal-cancel" class="button-secondary" @onclick="CloseModal">Cancel</button>
                    <button id="action-modal-apply" @onclick="ApplyModalAsync">Apply</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private enum ModalKind { None, Defer, ConfirmPaid, Override, PayPartial, RemoveDeferral, UndoConfirmation, UndoPartialPayment }

    private const string ShowResolvedStorageKey = "expense-forecast-show-resolved";

    private ForecastResult? _result;
    private ForecastLedgerRow? _lowestRow;
    private bool _showResolved = true;

    private ModalKind _activeModal = ModalKind.None;
    private ForecastLedgerRow? _modalRow;
    private PartialPaymentSummary? _modalPartialPayment;
    private DateOnly _modalDate;
    private decimal? _modalAmount;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ShowResolvedStorageKey);
        if (bool.TryParse(saved, out var savedShowResolved) && savedShowResolved != _showResolved)
        {
            _showResolved = savedShowResolved;
            StateHasChanged();
        }
    }

    private async Task ToggleShowResolvedAsync(ChangeEventArgs e)
    {
        _showResolved = (bool)e.Value!;
        await JS.InvokeVoidAsync("localStorage.setItem", ShowResolvedStorageKey, _showResolved.ToString());
    }

    private static decimal? ParseNullableDecimal(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : decimal.Parse(value);

    // A line's Amount sign already is its direction by construction (RecurrenceExpander
    // negates every expense line, leaves income positive) - no separate Direction field
    // needed on the row itself. Used only for wording (button/modal labels) and to tag a new
    // partial payment's real cash-movement record correctly, never for the reduction math
    // itself (that anchors on the original budgeted LedgerLine.Amount, not this row's already-
    // netted display value - see ForecastEngine).
    private static bool IsIncomeLine(ForecastLedgerRow row) => row.Amount >= 0;

    private void OpenDeferModal(ForecastLedgerRow row)
    {
        _activeModal = ModalKind.Defer;
        _modalRow = row;
        _modalDate = row.OriginalDate;
    }

    private void OpenConfirmModal(ForecastLedgerRow row)
    {
        _activeModal = ModalKind.ConfirmPaid;
        _modalRow = row;
    }

    private void OpenOverrideModal(ForecastLedgerRow row)
    {
        _activeModal = ModalKind.Override;
        _modalRow = row;
        _modalAmount = row.SuggestedOverrideAmount ?? row.Amount;
        _modalDate = row.SuggestedOverrideDate ?? row.Date;
    }

    private void OpenPayPartialModal(ForecastLedgerRow row)
    {
        _activeModal = ModalKind.PayPartial;
        _modalRow = row;
        _modalAmount = null;
        _modalDate = DateOnly.FromDateTime(DateTime.Today);
    }

    private void OpenRemoveDeferralModal(ForecastLedgerRow row)
    {
        _activeModal = ModalKind.RemoveDeferral;
        _modalRow = row;
    }

    private void OpenUndoConfirmationModal(ForecastLedgerRow row)
    {
        _activeModal = ModalKind.UndoConfirmation;
        _modalRow = row;
    }

    private void OpenUndoPartialPaymentModal(ForecastLedgerRow row, PartialPaymentSummary partialPayment)
    {
        _activeModal = ModalKind.UndoPartialPayment;
        _modalRow = row;
        _modalPartialPayment = partialPayment;
    }

    private void CloseModal()
    {
        _activeModal = ModalKind.None;
        _modalRow = null;
        _modalPartialPayment = null;
    }

    // Confirm Paid still just resubmits the row's own current Date/Amount, unchanged (see the
    // "why do these behave identically" conversation) - it means "this happened exactly as
    // scheduled," so there's nothing to edit. Override now accepts a real edited amount/date
    // instead (see the Gas $70.97-vs-$76.68 conversation) - it means "something different
    // actually happened," pre-filled with a suggested real transaction's amount when one was
    // found close by but outside the auto-reconciliation tolerance.
    private async Task ApplyModalAsync()
    {
        if (_modalRow is not { } row) return;

        switch (_activeModal)
        {
            case ModalKind.Defer:
                await ForecastResultProvider.DeferPaymentAsync(row.AccountId, row.OriginalDate, _modalDate, null);
                break;
            case ModalKind.ConfirmPaid:
                await ForecastResultProvider.ConfirmPaymentAsync(row.AccountId, row.CategoryId, row.OriginalDate, row.Date, row.Amount);
                break;
            case ModalKind.Override:
                if (_modalAmount is not { } overrideAmount) { CloseModal(); return; }
                await ForecastResultProvider.OverridePaymentAsync(row.AccountId, row.CategoryId, row.OriginalDate, _modalDate, overrideAmount);
                break;
            case ModalKind.PayPartial:
                if (_modalAmount is not { } amount || amount <= 0m) { CloseModal(); return; }
                await ForecastResultProvider.PayPartialAmountAsync(row.AccountId, row.OriginalDate, _modalDate, amount, IsIncomeLine(row) ? Direction.Income : Direction.Expense);
                break;
            case ModalKind.RemoveDeferral:
                if (row.DeferralId is { } deferralId) await ForecastResultProvider.RemoveDeferralAsync(deferralId);
                break;
            case ModalKind.UndoConfirmation:
                if (row.ConfirmationId is { } confirmationId) await ForecastResultProvider.RemoveConfirmationAsync(confirmationId);
                break;
            case ModalKind.UndoPartialPayment:
                if (_modalPartialPayment is { } partialPayment) await ForecastResultProvider.RemovePartialPaymentAsync(partialPayment.PartialPaymentId);
                break;
        }

        CloseModal();
        await RefreshAsync();
    }

    private string ModalTitle() => _activeModal switch
    {
        ModalKind.Defer => "Defer this payment?",
        ModalKind.ConfirmPaid => "Confirm this was paid as scheduled?",
        ModalKind.Override => "Change this amount?",
        ModalKind.PayPartial => _modalRow is not null && IsIncomeLine(_modalRow) ? "Record partial income?" : "Record a partial payment?",
        ModalKind.RemoveDeferral => "Remove this deferral?",
        ModalKind.UndoConfirmation => "Undo this confirmation?",
        ModalKind.UndoPartialPayment => "Undo this partial payment?",
        _ => ""
    };

    private string ModalExplanation() => _activeModal switch
    {
        ModalKind.Defer =>
            $"Moves \"{_modalRow?.Description}\" to a new date. The amount stays the same - you'll still owe the same total, just later. Remember to actually reschedule the real bill if this is a real payment.",
        ModalKind.ConfirmPaid =>
            $"Marks \"{_modalRow?.Description}\" as paid on {_modalRow?.Date.ToString("MM/dd/yyyy")} for {_modalRow?.Amount.ToString("N2")}, exactly as scheduled. It'll be removed from your still-owed list since it's already happened.",
        ModalKind.Override => _modalRow?.SuggestedOverrideAmount is { } suggested
            ? $"A transaction for {suggested.ToString("N2")} posted {_modalRow?.SuggestedOverrideDate?.ToString("MM/dd/yyyy")} was found close to this line but didn't auto-match - edit the amount/date below if this isn't it, then apply to mark \"{_modalRow?.Description}\" resolved. It'll be removed from your still-owed list."
            : $"No matching transaction was found - enter what actually happened below to mark \"{_modalRow?.Description}\" resolved, replacing what was scheduled. It'll be removed from your still-owed list.",
        ModalKind.PayPartial => _modalRow is not null && IsIncomeLine(_modalRow)
            ? $"Records partial income received toward \"{_modalRow.Description}\". The remaining expected amount stays on the forecast for the rest."
            : $"Records a partial payment against \"{_modalRow?.Description}\". The remaining balance stays on the forecast for the rest.",
        ModalKind.RemoveDeferral =>
            $"Puts \"{_modalRow?.Description}\" back on its originally scheduled date of {_modalRow?.OriginalDate.ToString("MM/dd/yyyy")}.",
        ModalKind.UndoConfirmation =>
            $"Puts \"{_modalRow?.Description}\" back on the forecast as a projected, unpaid amount.",
        ModalKind.UndoPartialPayment =>
            $"Removes the {_modalPartialPayment?.Amount.ToString("N2")} partial payment made on {_modalPartialPayment?.PaidDate.ToString("MM/dd/yyyy")}, restoring that amount to \"{_modalRow?.Description}\"'s remaining balance.",
        _ => ""
    };

    private async Task RefreshAsync()
    {
        _result = await ForecastResultProvider.GetForecastAsync();
        _lowestRow = _result.Rows.FirstOrDefault(r => !r.IsExcluded && r.RunningBalance == _result.LowestProjectedBalance);
    }

    private string RowStyle(ForecastLedgerRow row) =>
        row.IsExcluded ? "text-decoration: line-through; color: #888;"
        : row.IsDeferred ? "background-color: orange"
        : row == _lowestRow ? "background-color: yellow"
        : "";

    private static string CellStyle(bool rightAlign = false) =>
        $"border: 1px solid #ccc; padding: 6px 16px;{(rightAlign ? " text-align: right;" : "")}";
}
