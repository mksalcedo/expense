@page "/"
@using Expense.Domain.Entities
@using Expense.Domain.Services.Accounts
@using Expense.Domain.Services.Dashboard
@using Expense.Domain.Services.Forecast
@using Expense.Domain.Services.SpendingTracker
@using Expense.Web.Components.Shared
@inject IForecastResultProvider ForecastProvider
@inject ISpendingTrackerPageProvider SpendingTrackerProvider
@inject ISyncStatusProvider SyncStatusProvider
@inject IAccountsPageProvider AccountsProvider
@inject IJSRuntime JS

<PageTitle>Dashboard - @DateTime.Today.ToString("MMMM d, yyyy")</PageTitle>

<h1>Dashboard - @DateTime.Today.ToString("MMMM d, yyyy")</h1>

@if (_forecast is null || _spendingTracker is null)
{
    <p>Loading...</p>
}
else
{
    @if (_lastSimpleFinRun is { Success: false } || _lastAmazonRun is { Success: false } || _lastPlaidRun is { Success: false })
    {
        <div id="sync-failure-banner" style="background:#fee2e2; color:#7f1d1d; border:1px solid #fca5a5; border-radius:6px; padding:0.75em 1em; margin-bottom:1em;">
            <strong>Sync issue:</strong>
            @if (_lastSimpleFinRun is { Success: false } failedSimpleFin)
            {
                <div>Bank sync failed: @failedSimpleFin.ErrorMessage</div>
            }
            @if (_lastAmazonRun is { Success: false } failedAmazon)
            {
                <div>Amazon sync failed: @failedAmazon.ErrorMessage</div>
            }
            @if (_lastPlaidRun is { Success: false } failedPlaid)
            {
                <div>Plaid sync failed: @failedPlaid.ErrorMessage</div>
            }
            <div><a href="/import-data">Go to Import Data</a></div>
        </div>
    }

    <div style="display:flex; gap:3rem; align-items:flex-start; flex-wrap:wrap;">
        <div>
            <h2>Cash Flow</h2>
            <table style="margin-bottom: 1.5em;">
                <thead>
                    <tr>
                        <th>Summary</th>
                        <th class="text-right">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr id="starting-balance-row">
                        <td>Starting balance</td>
                        <td class="text-right">@_forecast.StartingBalance.ToString("N2")</td>
                    </tr>
                    <tr id="lowest-balance-row">
                        <td>
                            Lowest projected balance
                            @if (_forecast.LowestProjectedBalanceDate is { } lowestDate)
                            {
                                <br /><span style="color:#666; font-size:0.9em;">Occurs on @lowestDate.ToString("MM/dd/yyyy")</span>
                            }
                        </td>
                        <td class="text-right">@_forecast.LowestProjectedBalance.ToString("N2")</td>
                    </tr>
                    @if (_savingsBalance is { } savings)
                    {
                        <tr id="savings-row">
                            <td>Savings</td>
                            <td class="text-right">@savings.ToString("N2")</td>
                        </tr>
                        <tr id="lowest-balance-plus-savings-row" style="font-weight: 600;">
                            <td>Lowest projected balance + savings</td>
                            <td class="text-right">@((_forecast.LowestProjectedBalance + savings).ToString("N2"))</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p>
                <label>
                    <input id="show-resolved-toggle" type="checkbox" checked="@_showResolved" @onchange="ToggleShowResolvedAsync" />
                    Show resolved items (paid, overridden, or auto-reconciled)
                </label>
            </p>
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th class="text-right">Amount</th>
                        <th class="text-right">Running balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _forecast.Rows.Where(r => _showResolved || !r.IsExcluded).Take(20))
                    {
                        <tr style="@CashFlowRowStyle(row)">
                            <td>@row.Date.ToString("yyyy-MM-dd")</td>
                            <td>
                                @row.Description
                                @if (row.IsExcluded)
                                {
                                    <br />
                                    <span style="color: #666">(@row.ExclusionReason)</span>
                                }
                                else if (row.IsDeferred)
                                {
                                    <br />
                                    <span style="color: red">&#9888; Originally estimated for @row.OriginalDate.ToString("MM/dd/yyyy")</span>
                                }
                            </td>
                            <td class="text-right">@row.Amount.ToString("N2")</td>
                            <td class="text-right">@row.RunningBalance.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p><a href="/forecast">View full forecast</a></p>
        </div>

        <div>
            @RenderSpendingTable("spending-week", _spendingTracker.Week, WeekTitle(_spendingTracker.Week), PreviousWeekAsync, NextWeekAsync, CurrentWeekAsync)
            @RenderSpendingTable("spending-month", _spendingTracker.Month, MonthTitle(_spendingTracker.Month), PreviousMonthAsync, NextMonthAsync, CurrentMonthAsync)
            <p><a href="/spending-tracker">View spending tracker</a></p>
        </div>
    </div>

    <div style="margin-top: 1rem;">
        <h2 style="margin-bottom: 0.3em;">Cash Flow Trend (12 Months)</h2>
        <CashFlowChart Forecast="_forecast" />
    </div>
}

@code {
    // Deliberately a separate key from Forecast.razor's own - user confirmed 2026-08-07 that
    // the two pages' "show resolved items" preferences should be independent, not shared.
    private const string ShowResolvedStorageKey = "expense-dashboard-show-resolved";

    private ForecastResult? _forecast;
    private ForecastLedgerRow? _lowestForecastRow;
    private SpendingTrackerPageData? _spendingTracker;
    private decimal? _savingsBalance;
    private DateOnly _weekReferenceDate;
    private DateOnly _monthReferenceDate;
    private ImportRun? _lastSimpleFinRun;
    private ImportRun? _lastAmazonRun;
    private ImportRun? _lastPlaidRun;
    private bool _showResolved = true;

    protected override async Task OnInitializedAsync()
    {
        await RefreshDashboardDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ShowResolvedStorageKey);
        if (bool.TryParse(saved, out var savedShowResolved) && savedShowResolved != _showResolved)
        {
            _showResolved = savedShowResolved;
            StateHasChanged();
        }
    }

    private async Task ToggleShowResolvedAsync(ChangeEventArgs e)
    {
        _showResolved = (bool)e.Value!;
        await JS.InvokeVoidAsync("localStorage.setItem", ShowResolvedStorageKey, _showResolved.ToString());
    }

    // A sync (now done from the Sync Now page) can add transactions/orders that change every
    // figure shown here - the running balance and category totals - so this always fetches
    // fresh data on every visit to this page rather than caching anything across navigations.
    private async Task RefreshDashboardDataAsync()
    {
        _forecast = await ForecastProvider.GetForecastAsync();
        _lowestForecastRow = _forecast.Rows.FirstOrDefault(r => !r.IsExcluded && r.RunningBalance == _forecast.LowestProjectedBalance);
        _spendingTracker = await SpendingTrackerProvider.GetSpendingTrackerAsync();
        _weekReferenceDate = _spendingTracker.Week.PeriodStart;
        _monthReferenceDate = _spendingTracker.Month.PeriodStart;
        _lastSimpleFinRun = await SyncStatusProvider.GetLastSimpleFinRunAsync();
        _lastAmazonRun = await SyncStatusProvider.GetLastAmazonGmailRunAsync();
        _lastPlaidRun = await SyncStatusProvider.GetLastPlaidRunAsync();

        var accounts = await AccountsProvider.GetAccountsAsync();
        var savingsAccounts = accounts.Accounts.Where(a => a.Type == AccountType.Savings && a.IsActive && a.LatestBalance.HasValue).ToList();
        _savingsBalance = savingsAccounts.Count > 0 ? savingsAccounts.Sum(a => a.LatestBalance!.Value) : null;
    }

    // Mirrors Forecast.razor's own row styling, so a deferred/excluded payment looks the
    // same whether you're looking at the Dashboard's summary or the full Forecast page.
    private string CashFlowRowStyle(ForecastLedgerRow row) =>
        row.IsExcluded ? "text-decoration: line-through; color: #888;"
        : row.IsDeferred ? "background-color: orange"
        : row == _lowestForecastRow ? "background-color: yellow"
        : "";

    private static string WeekTitle(SpendingTrackerResult result) => $"Spending for Week Ending {result.PeriodEnd:MM/dd/yyyy}";
    private static string MonthTitle(SpendingTrackerResult result) => $"Spending for {result.PeriodStart:MMMM, yyyy}";

    // Navigation always shifts relative to whatever period is currently displayed (its own
    // PeriodStart), not an independently-tracked "today" - keeps repeated Previous/Next clicks
    // consistent with what's actually on screen. Current jumps back to the real today instead.
    private async Task PreviousWeekAsync()
    {
        _weekReferenceDate = _weekReferenceDate.AddDays(-7);
        _spendingTracker!.Week = await SpendingTrackerProvider.GetWeekAsync(_weekReferenceDate);
    }

    private async Task NextWeekAsync()
    {
        _weekReferenceDate = _weekReferenceDate.AddDays(7);
        _spendingTracker!.Week = await SpendingTrackerProvider.GetWeekAsync(_weekReferenceDate);
    }

    private async Task CurrentWeekAsync()
    {
        _weekReferenceDate = DateOnly.FromDateTime(DateTime.Today);
        _spendingTracker!.Week = await SpendingTrackerProvider.GetWeekAsync(_weekReferenceDate);
    }

    private async Task PreviousMonthAsync()
    {
        _monthReferenceDate = _monthReferenceDate.AddMonths(-1);
        _spendingTracker!.Month = await SpendingTrackerProvider.GetMonthAsync(_monthReferenceDate);
    }

    private async Task NextMonthAsync()
    {
        _monthReferenceDate = _monthReferenceDate.AddMonths(1);
        _spendingTracker!.Month = await SpendingTrackerProvider.GetMonthAsync(_monthReferenceDate);
    }

    private async Task CurrentMonthAsync()
    {
        _monthReferenceDate = DateOnly.FromDateTime(DateTime.Today);
        _spendingTracker!.Month = await SpendingTrackerProvider.GetMonthAsync(_monthReferenceDate);
    }

    // Same table shape (category rows + Pending row + Totals row folding Pending into
    // Actual/Remaining) as the Spending Tracker page itself - kept in sync deliberately,
    // since this is meant to be a faithful at-a-glance copy, not a simplified one.
    private RenderFragment RenderSpendingTable(
        string idPrefix, SpendingTrackerResult result, string title, Func<Task> onPrevious, Func<Task> onNext, Func<Task> onCurrent) => @<div style="margin-bottom: 3.5em;">
        <h2 id="@(idPrefix)-title" style="margin-bottom: 0.3em;">@title</h2>
        <div style="margin-bottom: 0.5em;">
            <button id="@(idPrefix)-previous" @onclick="onPrevious">&laquo; Previous</button>
            <button id="@(idPrefix)-current" @onclick="onCurrent">Current</button>
            <button id="@(idPrefix)-next" @onclick="onNext">Next &raquo;</button>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Category</th>
                    <th class="text-right">Budget</th>
                    <th class="text-right">Actual</th>
                    <th class="text-right">Remaining</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in result.Categories)
                {
                    <tr>
                        <td>@category.CategoryName</td>
                        <td class="text-right">@category.Budget.ToString("N2")</td>
                        <td class="text-right">@category.Actual.ToString("N2")</td>
                        <td class="text-right">@category.Remaining.ToString("N2")</td>
                    </tr>
                }
                <tr id="@(idPrefix)-pending-row">
                    <td>Pending / Uncategorized</td>
                    <td></td>
                    <td class="text-right">@result.PendingAmount.ToString("N2")</td>
                    <td></td>
                </tr>
            </tbody>
            <tfoot>
                @{
                    var budgetTotal = result.Categories.Sum(c => c.Budget);
                    var actualTotal = result.Categories.Sum(c => c.Actual) + result.PendingAmount;
                }
                <tr id="@(idPrefix)-totals-row" style="font-weight: 600; border-top: 2px solid var(--color-border, #ccc)">
                    <td>Total</td>
                    <td class="text-right">@budgetTotal.ToString("N2")</td>
                    <td class="text-right">@actualTotal.ToString("N2")</td>
                    <td class="text-right">@((budgetTotal - actualTotal).ToString("N2"))</td>
                </tr>
            </tfoot>
        </table>
    </div>;
}
