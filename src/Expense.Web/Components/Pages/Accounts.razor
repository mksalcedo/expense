@page "/accounts"
@using Expense.Domain.Entities
@using Expense.Domain.Services
@using Expense.Domain.Services.Accounts
@using Expense.Web.Components.Shared
@implements IDisposable
@inject IAccountsPageProvider AccountsProvider
@inject IDataChangeNotifier DataChangeNotifier

<PageTitle>Accounts</PageTitle>

<h1>Accounts</h1>

<NewDataBanner Show="_newDataAvailable" OnRefresh="RefreshNowAsync" />

@if (_data is null)
{
    <p>Loading...</p>
}
else
{
    <div style="display:flex; gap:2rem; align-items:flex-start;">
        <div style="flex: 3;">
            <div style="margin-bottom: 10px;">
                <input id="account-filter" placeholder="Filter by name..." value="@_filterText"
                       @oninput="e => _filterText = (string)e.Value!" />
                <button id="new-account-button" @onclick="StartCreating">+ New Account</button>
            </div>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-radius: 8px; overflow: hidden;">
                    <thead>
                        <tr>
                            <th @onclick='() => Sort("Name")' style="cursor:pointer;">Name</th>
                            <th @onclick='() => Sort("Type")' style="cursor:pointer;">Type</th>
                            <th @onclick='() => Sort("Status")' style="cursor:pointer;">Status</th>
                            <th @onclick='() => Sort("MinPayment")' style="cursor:pointer;" class="text-right">Min Payment</th>
                            <th @onclick='() => Sort("PaymentDueDay")' style="cursor:pointer;" class="text-right">Payment Due Day</th>
                            <th @onclick='() => Sort("Apr")' style="cursor:pointer;" class="text-right">APR</th>
                            <th @onclick='() => Sort("Balance")' style="cursor:pointer;" class="text-right">Balance</th>
                            <th @onclick='() => Sort("AsOf")' style="cursor:pointer;" class="text-right">As of</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in VisibleAccounts())
                        {
                            <tr @key="account.Id" id="account-row-@account.Id" @onclick="() => SelectAsync(account)"
                                style="cursor:pointer; @(account.Id == _selectedId ? "font-weight:bold;" : "")">
                                <td>@account.Name</td>
                                <td>@account.Type</td>
                                <td>@(account.IsActive ? "Active" : "Inactive")</td>
                                <td class="text-right">@(account.MinPayment?.ToString("N2") ?? "-")</td>
                                <td class="text-right">@(account.PaymentDueDay?.ToString() ?? "-")</td>
                                <td class="text-right">@(account.Apr.HasValue ? account.Apr.Value.ToString("N2") + "%" : "-")</td>
                                <td class="text-right">@FormatBalance(account.LatestBalance, account.Type)</td>
                                <td class="text-right">@(account.LatestBalanceAsOfDate?.ToString("MM/dd/yyyy") ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3"><strong>Total (active accounts)</strong></td>
                            <td id="total-min-payment" class="text-right"><strong>@TotalMinPayment().ToString("N2")</strong></td>
                            <td></td>
                            <td></td>
                            <td id="total-balance" class="text-right"><strong>@FormatBalance(TotalBalance())</strong></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div style="flex: 2;">
            @if (_mode == DetailMode.None)
            {
                <p>Select an account on the left to edit it, or click "New Account" to create one.</p>
            }
            else
            {
                <div class="detail-panel">
                    <h2>@(_mode == DetailMode.Creating ? "New account" : "Edit account")</h2>
                    @if (_saveConfirmationVisible)
                    {
                        <p id="save-confirmation" style="color: #1a7f37; font-weight: 500;">Saved.</p>
                    }
                    <div class="detail-form">
                        <div style="display: contents">
                            <label for="detail-name">Name</label>
                            <input id="detail-name" value="@_formName" @onchange="e => _formName = (string)e.Value!" />
                        </div>
                        @if (_mode == DetailMode.Creating)
                        {
                            <div style="display: contents">
                                <label for="detail-type">Type</label>
                                <select id="detail-type" @onchange="e => _formType = Enum.Parse<AccountType>((string)e.Value!)">
                                    @foreach (var type in Enum.GetValues<AccountType>())
                                    {
                                        <option value="@type" selected="@(_formType == type)">@type</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <label>Type</label>
                            <p style="margin: 0;">@_formType</p>
                        }
                        @if (_formType == AccountType.Debt || _formType == AccountType.ActiveSpending)
                        {
                            <div style="display: contents">
                                <label for="detail-min-payment">Min payment</label>
                                <input id="detail-min-payment" type="number" step="0.01" value="@_formMinPayment"
                                       @onchange="e => _formMinPayment = ParseNullableDecimal((string)e.Value!)" />
                            </div>
                            <div style="display: contents">
                                <label for="detail-extra-payment">Extra payment</label>
                                <input id="detail-extra-payment" type="number" step="0.01" value="@_formExtraPayment"
                                       @onchange="e => _formExtraPayment = ParseNullableDecimal((string)e.Value!)" />
                            </div>
                            <div style="display: contents">
                                <label for="detail-payment-due-day">Payment due day</label>
                                <input id="detail-payment-due-day" type="number" value="@_formPaymentDueDay"
                                       @onchange="e => _formPaymentDueDay = ParseNullableInt((string)e.Value!)" />
                            </div>
                            @if (_formType == AccountType.Debt)
                            {
                                <div style="display: contents">
                                    <label for="detail-payment-start-date">Payment start date</label>
                                    <input id="detail-payment-start-date" type="date" value="@_formPaymentStartDate?.ToString("yyyy-MM-dd")"
                                           @onchange="e => _formPaymentStartDate = ParseNullableDate((string)e.Value!)" />
                                </div>
                                <p style="grid-column: 1 / -1; margin: 0; color: #666; font-size: 0.9em;">
                                    Leave blank for an ordinary ongoing account. Set this when the real first payment is in the
                                    future (e.g. a new loan) - the forecast won't show a payment before this date.
                                </p>
                            }
                            @if (_formType == AccountType.ActiveSpending)
                            {
                                <div style="display: contents">
                                    <label for="detail-statement-close-day">Statement close day</label>
                                    <input id="detail-statement-close-day" type="number" value="@_formStatementCloseDay"
                                           @onchange="e => _formStatementCloseDay = ParseNullableInt((string)e.Value!)" />
                                </div>
                            }
                            <div style="display: contents">
                                <label for="detail-apr">APR %</label>
                                <input id="detail-apr" type="number" step="0.01" value="@_formApr"
                                       @onchange="e => _formApr = ParseNullableDecimal((string)e.Value!)" />
                            </div>
                        }
                    </div>

                    @if (_formType == AccountType.Debt || _formType == AccountType.ActiveSpending || _formType == AccountType.Savings)
                    {
                        <div class="detail-section">
                            <h3>Balance</h3>
                            @if (_selectedLatestBalance is { } balance)
                            {
                                <p>Latest: @FormatBalance(balance, _formType) as of @_selectedLatestBalanceAsOfDate!.Value.ToString("MM/dd/yyyy")</p>
                            }
                            else
                            {
                                <p><em>No balance recorded yet.</em></p>
                            }
                            <div class="detail-form">
                                <div style="display: contents">
                                    <label for="detail-balance-date">As of</label>
                                    <input id="detail-balance-date" type="date" value="@_formBalanceAsOfDate.ToString("yyyy-MM-dd")"
                                           @onchange="e => _formBalanceAsOfDate = DateOnly.Parse((string)e.Value!)" />
                                </div>
                                <div style="display: contents">
                                    <label for="detail-balance-amount">@(_formType == AccountType.Savings ? "Balance" : "Balance owed")</label>
                                    <input id="detail-balance-amount" type="number" step="0.01" value="@_formBalanceAmount"
                                           @onchange="e => _formBalanceAmount = ParseNullableDecimal((string)e.Value!)" />
                                </div>
                                @if (_formType != AccountType.Savings)
                                {
                                    <div style="display: contents">
                                        <label for="detail-balance-is-credit">Credit balance?</label>
                                        <input id="detail-balance-is-credit" type="checkbox" checked="@_formBalanceIsCredit"
                                               @onchange="e => _formBalanceIsCredit = (bool)e.Value!" style="justify-self: start;" />
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="button-row">
                        <button id="detail-save" @onclick="SaveAsync">Save</button>
                        @if (_mode == DetailMode.Editing)
                        {
                            @if (_selectedIsActive)
                            {
                                <button id="detail-deactivate" class="button-secondary" @onclick="DeactivateAsync">Deactivate</button>
                            }
                            else
                            {
                                <button id="detail-reactivate" class="button-secondary" @onclick="ReactivateAsync">Reactivate</button>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private enum DetailMode { None, Editing, Creating }

    private AccountsPageData? _data;
    private bool _newDataAvailable;
    private DetailMode _mode = DetailMode.None;
    private int? _selectedId;
    private bool _selectedIsActive;
    private string _filterText = "";
    private string _sortColumn = "Name";
    private bool _sortAscending = true;

    private string _formName = "";
    private AccountType _formType = AccountType.Debt;
    private decimal? _formMinPayment;
    private decimal? _formExtraPayment;
    private int? _formPaymentDueDay;
    private int? _formStatementCloseDay;
    private decimal? _formApr;
    private DateOnly? _formPaymentStartDate;

    private decimal? _selectedLatestBalance;
    private DateOnly? _selectedLatestBalanceAsOfDate;
    private DateOnly _formBalanceAsOfDate = DateOnly.FromDateTime(DateTime.Today);

    // Always a positive magnitude in the UI, regardless of how it's stored - see FormatBalance
    // and SaveAsync for the sign translation. Nobody should have to type a minus sign to record
    // an everyday "I owe this much" balance.
    private decimal? _formBalanceAmount;
    private bool _formBalanceIsCredit;

    private bool _saveConfirmationVisible;

    protected override async Task OnInitializedAsync()
    {
        _data = await AccountsProvider.GetAccountsAsync();
        DataChangeNotifier.Changed += OnDataChanged;
    }

    // Fires from a background sync (scheduled or a manual Sync Now click from any page).
    // With nothing selected, there's nothing an auto-refresh could disrupt, so it behaves
    // like a pure display page and refreshes silently. With an account selected and its
    // edit form open, silently reloading the list could yank the form's row out from
    // under an in-progress edit - shows the softer banner instead.
    private async void OnDataChanged()
    {
        if (_mode == DetailMode.None)
        {
            _data = await AccountsProvider.GetAccountsAsync();
        }
        else
        {
            _newDataAvailable = true;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshNowAsync()
    {
        _newDataAvailable = false;
        _data = await AccountsProvider.GetAccountsAsync();
    }

    public void Dispose()
    {
        DataChangeNotifier.Changed -= OnDataChanged;
    }

    private static decimal? ParseNullableDecimal(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : decimal.Parse(value);

    private static int? ParseNullableInt(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : int.Parse(value);

    private static DateOnly? ParseNullableDate(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : DateOnly.Parse(value);

    // Storage convention (matches the accounting/SimpleFin data already in the database):
    // negative = amount owed, positive = credit balance. Display always shows a positive
    // magnitude - a credit gets a "CR" suffix instead of a bare positive number, so it reads
    // unambiguously rather than looking like an ordinary (larger) debt. Savings has no
    // owed/credit distinction at all (always a plain positive asset amount), so it never gets
    // the "CR" suffix - that word implies a debt account that's overpaid, not a savings balance.
    private static string FormatBalance(decimal? balance, AccountType? type = null) => balance switch
    {
        null => "-",
        < 0 => Math.Abs(balance.Value).ToString("N2"),
        > 0 when type == AccountType.Savings => balance.Value.ToString("N2"),
        > 0 => balance.Value.ToString("N2") + " CR",
        _ => "0.00"
    };

    private List<AccountRow> VisibleAccounts()
    {
        var filtered = _data!.Accounts
            .Where(a => string.IsNullOrWhiteSpace(_filterText) || a.Name.Contains(_filterText, StringComparison.OrdinalIgnoreCase));

        Func<AccountRow, IComparable> keySelector = _sortColumn switch
        {
            "Type" => a => a.Type,
            "Status" => a => a.IsActive,
            "MinPayment" => a => a.MinPayment ?? decimal.MinValue,
            "PaymentDueDay" => a => a.PaymentDueDay ?? int.MinValue,
            "Apr" => a => a.Apr ?? decimal.MinValue,
            "Balance" => a => a.LatestBalance ?? decimal.MinValue,
            "AsOf" => a => a.LatestBalanceAsOfDate ?? DateOnly.MinValue,
            _ => a => a.Name
        };

        var sorted = _sortAscending ? filtered.OrderBy(keySelector) : filtered.OrderByDescending(keySelector);
        return sorted.ToList();
    }

    // Only active accounts - a closed/inactive account's stale MinPayment/Balance shouldn't
    // inflate what's meant to read as "what I currently owe/pay across real accounts".
    private decimal TotalMinPayment() => VisibleAccounts().Where(a => a.IsActive).Sum(a => a.MinPayment ?? 0m);
    private decimal TotalBalance() => VisibleAccounts().Where(a => a.IsActive).Sum(a => a.LatestBalance ?? 0m);

    private void Sort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private void StartCreating()
    {
        _mode = DetailMode.Creating;
        _selectedId = null;
        _formName = "";
        _formType = AccountType.Debt;
        _formMinPayment = null;
        _formExtraPayment = null;
        _formPaymentDueDay = null;
        _formStatementCloseDay = null;
        _formApr = null;
        _formPaymentStartDate = null;
        _selectedLatestBalance = null;
        _selectedLatestBalanceAsOfDate = null;
        _formBalanceAsOfDate = DateOnly.FromDateTime(DateTime.Today);
        _formBalanceAmount = null;
        _formBalanceIsCredit = false;
        _saveConfirmationVisible = false;
    }

    private void LoadIntoForm(AccountRow account)
    {
        _selectedId = account.Id;
        _selectedIsActive = account.IsActive;
        _formName = account.Name;
        _formType = account.Type;
        _formMinPayment = account.MinPayment;
        _formExtraPayment = account.ExtraPayment;
        _formPaymentDueDay = account.PaymentDueDay;
        _formStatementCloseDay = account.StatementCloseDay;
        _formApr = account.Apr;
        _formPaymentStartDate = account.PaymentStartDate;
        _selectedLatestBalance = account.LatestBalance;
        _selectedLatestBalanceAsOfDate = account.LatestBalanceAsOfDate;
        _formBalanceAsOfDate = DateOnly.FromDateTime(DateTime.Today);
        _formBalanceAmount = account.LatestBalance.HasValue ? Math.Abs(account.LatestBalance.Value) : null;
        _formBalanceIsCredit = account.LatestBalance is > 0;
    }

    private Task SelectAsync(AccountRow account)
    {
        _mode = DetailMode.Editing;
        _saveConfirmationVisible = false;
        LoadIntoForm(account);
        return Task.CompletedTask;
    }

    /// <summary>
    /// One Save button commits everything together - name/payment/APR fields plus, if a
    /// balance was entered, a dated balance snapshot - rather than a separate "Update Balance"
    /// action. Stays in Editing mode afterward (switching a fresh Create straight into Editing
    /// the new row) instead of closing the form, so a "Saved" confirmation can show without the
    /// user having to reselect the row to see it worked.
    /// </summary>
    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_formName)) return;

        int accountId;
        if (_mode == DetailMode.Creating)
        {
            accountId = await AccountsProvider.CreateAccountAsync(
                _formName, _formType, _formMinPayment, _formExtraPayment, _formPaymentDueDay, _formStatementCloseDay, _formApr, _formPaymentStartDate);
        }
        else if (_selectedId is { } id)
        {
            accountId = id;
            await AccountsProvider.UpdateAccountAsync(
                id, _formName, _formMinPayment, _formExtraPayment, _formPaymentDueDay, _formStatementCloseDay, _formApr, _formPaymentStartDate);
        }
        else
        {
            return;
        }

        if ((_formType == AccountType.Debt || _formType == AccountType.ActiveSpending || _formType == AccountType.Savings) && _formBalanceAmount is { } enteredBalance)
        {
            // Savings is always a plain asset amount - no owed-vs-credit distinction, so no sign flip.
            var storedBalance = _formType == AccountType.Savings ? enteredBalance : _formBalanceIsCredit ? enteredBalance : -enteredBalance;
            await AccountsProvider.UpdateBalanceAsync(accountId, _formBalanceAsOfDate, storedBalance);
        }

        _data = await AccountsProvider.GetAccountsAsync();
        _mode = DetailMode.Editing;
        LoadIntoForm(_data.Accounts.Single(a => a.Id == accountId));
        _saveConfirmationVisible = true;
    }

    private async Task DeactivateAsync()
    {
        if (_selectedId is not { } id) return;
        await AccountsProvider.DeactivateAccountAsync(id);
        _mode = DetailMode.None;
        _selectedId = null;
        _data = await AccountsProvider.GetAccountsAsync();
    }

    private async Task ReactivateAsync()
    {
        if (_selectedId is not { } id) return;
        await AccountsProvider.ReactivateAccountAsync(id);
        _mode = DetailMode.None;
        _selectedId = null;
        _data = await AccountsProvider.GetAccountsAsync();
    }
}
