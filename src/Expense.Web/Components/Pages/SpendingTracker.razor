@page "/spending-tracker"
@using Expense.Domain.Services.SpendingTracker
@inject ISpendingTrackerPageProvider SpendingTrackerProvider

<PageTitle>Spending Tracker</PageTitle>

<h1>Spending Tracker</h1>

@if (_data is null)
{
    <p>Loading...</p>
}
else
{
    <div style="display:flex; gap:3rem; align-items:flex-start;">
        @RenderPeriod("This Week", "week", _data.Week)
        @RenderPeriod("This Month", "month", _data.Month)
    </div>
}

@code {
    private SpendingTrackerPageData? _data;
    private int? _resettingCategoryId;

    // One selected category per table (week/month), not a set - selecting a different
    // category replaces whichever detail table was showing, it never stacks.
    private readonly Dictionary<string, int?> _selectedCategoryId = [];
    private readonly Dictionary<string, List<CategoryTransactionLine>> _categoryTransactions = [];

    protected override async Task OnInitializedAsync()
    {
        _data = await SpendingTrackerProvider.GetSpendingTrackerAsync();
    }

    private async Task ResetCarryoverAsync(int categoryId, bool startingNextPeriod)
    {
        await SpendingTrackerProvider.ResetCarryoverAsync(categoryId, startingNextPeriod);
        _resettingCategoryId = null;
        _data = await SpendingTrackerProvider.GetSpendingTrackerAsync();
    }

    private static string TransactionsCacheKey(string idPrefix, int categoryId) => $"{idPrefix}:{categoryId}";

    // Lazy-loaded on first click, not fetched up front for every category - most categories
    // are never selected, so eagerly pulling item-level detail for all of them would be
    // wasted work. Cached afterward so switching back to an already-viewed category doesn't
    // re-fetch.
    private async Task SelectCategoryDetailsAsync(string idPrefix, int categoryId, DateOnly periodStart, DateOnly periodEnd)
    {
        if (_selectedCategoryId.GetValueOrDefault(idPrefix) == categoryId)
        {
            _selectedCategoryId[idPrefix] = null;
            return;
        }

        _selectedCategoryId[idPrefix] = categoryId;

        var key = TransactionsCacheKey(idPrefix, categoryId);
        if (!_categoryTransactions.ContainsKey(key))
        {
            _categoryTransactions[key] = await SpendingTrackerProvider.GetCategoryTransactionsAsync(categoryId, periodStart, periodEnd);
        }
    }

    private RenderFragment RenderPeriod(string title, string idPrefix, SpendingTrackerResult result) => @<div style="min-width: 520px;">
        <h2>@title</h2>
        <p>@result.PeriodStart.ToString("yyyy-MM-dd") to @result.PeriodEnd.ToString("yyyy-MM-dd")</p>
        <table style="width: 100%;">
            <thead>
                <tr>
                    <th>Category</th>
                    <th class="text-right">Budget</th>
                    <th class="text-right">Actual</th>
                    <th class="text-right">Remaining</th>
                    <th>Carryover</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in result.Categories)
                {
                    <tr>
                        <td>
                            <button id="category-link-@idPrefix-@category.CategoryId"
                                    style="background:none; border:none; padding:0; color:#0969da; text-decoration:underline; cursor:pointer; font:inherit;"
                                    @onclick="() => SelectCategoryDetailsAsync(idPrefix, category.CategoryId, result.PeriodStart, result.PeriodEnd)">
                                @category.CategoryName
                            </button>
                        </td>
                        <td class="text-right">@category.Budget.ToString("N2")</td>
                        <td class="text-right">@category.Actual.ToString("N2")</td>
                        <td class="text-right">
                            @((category.RollingBalance ?? category.Remaining).ToString("N2"))
                            @if (category.IsCarryoverTracked && category.CarriedIn != 0)
                            {
                                <br />
                                <span id="carried-in-note-@category.CategoryId" style="color:#666; font-size:0.85em;">
                                    @(category.CarriedIn > 0 ? "+" : "")@category.CarriedIn.ToString("N2") carried in
                                    @if (category.CarryoverCap is { } cap)
                                    {
                                        <text> (capped at &plusmn;@cap.ToString("N2"))</text>
                                    }
                                </span>
                            }
                        </td>
                        <td style="white-space: nowrap;">
                            @if (category.IsCarryoverTracked)
                            {
                                @if (_resettingCategoryId == category.CategoryId)
                                {
                                    <span id="reset-options-@category.CategoryId" style="font-size:0.85em;">
                                        <button id="reset-this-period-btn-@category.CategoryId" @onclick="() => ResetCarryoverAsync(category.CategoryId, startingNextPeriod: false)">This period</button>
                                        <button id="reset-next-period-btn-@category.CategoryId" @onclick="() => ResetCarryoverAsync(category.CategoryId, startingNextPeriod: true)">Next period</button>
                                        <button id="cancel-reset-btn-@category.CategoryId" @onclick="() => _resettingCategoryId = null">Cancel</button>
                                    </span>
                                }
                                else
                                {
                                    <button id="reset-carryover-btn-@category.CategoryId" style="font-size:0.85em;" @onclick="() => _resettingCategoryId = category.CategoryId">Reset...</button>
                                }
                            }
                        </td>
                    </tr>
                }
                <tr>
                    <td>Pending / Uncategorized</td>
                    <td></td>
                    <td class="text-right">@result.PendingAmount.ToString("N2")</td>
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
            <tfoot>
                @{
                    var budgetTotal = result.Categories.Sum(c => c.Budget);
                    // Pending is real money already spent, just not yet sorted into a
                    // category - it has to count toward the actual/remaining totals or
                    // this row would overstate how much budget is really left, the exact
                    // kind of "silently ignore uncategorized spend" mistake already fixed
                    // once before for the Amex forecast.
                    var actualTotal = result.Categories.Sum(c => c.Actual) + result.PendingAmount;
                    // Sums whatever's actually displayed per row (the carryover-adjusted
                    // RollingBalance where tracked, plain Remaining otherwise) rather than
                    // Budget-Actual, so the total reconciles with the column above it.
                    var remainingTotal = result.Categories.Sum(c => c.RollingBalance ?? c.Remaining) - result.PendingAmount;
                }
                <tr id="@(idPrefix)-totals-row" style="font-weight: 600; border-top: 2px solid var(--color-border, #ccc)">
                    <td>Total</td>
                    <td class="text-right">@budgetTotal.ToString("N2")</td>
                    <td class="text-right">@actualTotal.ToString("N2")</td>
                    <td class="text-right">@remainingTotal.ToString("N2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>

        @if (_selectedCategoryId.GetValueOrDefault(idPrefix) is { } selectedCategoryId)
        {
            var selectedCategoryName = result.Categories.First(c => c.CategoryId == selectedCategoryId).CategoryName;
            <h3 style="margin-top: 1.5em;">@selectedCategoryName transactions</h3>
            @if (!_categoryTransactions.TryGetValue(TransactionsCacheKey(idPrefix, selectedCategoryId), out var lines))
            {
                <p id="category-details-@idPrefix">Loading...</p>
            }
            else if (lines.Count == 0)
            {
                <p id="category-details-@idPrefix">No transactions found for this category in this period.</p>
            }
            else
            {
                <table id="category-details-@idPrefix" style="width: 100%;">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th class="text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in lines)
                        {
                            <tr>
                                <td>@line.Date.ToString("MM/dd/yyyy")</td>
                                <td>@line.Description</td>
                                <td class="text-right">@line.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr id="category-details-@(idPrefix)-total-row" style="font-weight: 600; border-top: 2px solid var(--color-border, #ccc)">
                            <td colspan="2">Total</td>
                            <td class="text-right">@lines.Sum(l => l.Amount).ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            }
        }
    </div>;
}
