@page "/spending-tracker"
@using Expense.Domain.Services
@using Expense.Domain.Services.SpendingTracker
@implements IDisposable
@inject ISpendingTrackerPageProvider SpendingTrackerProvider
@inject IDataChangeNotifier DataChangeNotifier

<PageTitle>Spending Tracker</PageTitle>

<h1>Spending Tracker</h1>

@if (_data is null)
{
    <p>Loading...</p>
}
else
{
    <div style="display:flex; gap:3rem; align-items:flex-start;">
        @RenderPeriod("This Week", "week", _data.Week, PreviousWeekAsync, NextWeekAsync, CurrentWeekAsync)
        @RenderPeriod("This Month", "month", _data.Month, PreviousMonthAsync, NextMonthAsync, CurrentMonthAsync)
    </div>
}

@code {
    private SpendingTrackerPageData? _data;
    private int? _resettingCategoryId;
    private DateOnly _weekReferenceDate;
    private DateOnly _monthReferenceDate;

    // One selected category per table (week/month), not a set - selecting a different
    // category replaces whichever detail table was showing, it never stacks.
    private readonly Dictionary<string, int?> _selectedCategoryId = [];
    private readonly Dictionary<string, List<CategoryTransactionLine>> _categoryTransactions = [];

    protected override async Task OnInitializedAsync()
    {
        _data = await SpendingTrackerProvider.GetSpendingTrackerAsync();
        _weekReferenceDate = _data.Week.PeriodStart;
        _monthReferenceDate = _data.Month.PeriodStart;
        DataChangeNotifier.Changed += OnDataChanged;
    }

    // Fires from a background sync (scheduled or a manual Sync Now click from any page) -
    // re-fetches both tables using their current reference dates rather than
    // GetSpendingTrackerAsync() (which always means "today"), so a background refresh
    // never silently resets Previous/Next navigation back to the current week/month. Also
    // refreshes whichever category detail table is currently open, same as the existing
    // navigation methods below, so it doesn't go stale relative to the totals above it.
    private async void OnDataChanged()
    {
        if (_data is null) return;
        _data.Week = await SpendingTrackerProvider.GetWeekAsync(_weekReferenceDate);
        _data.Month = await SpendingTrackerProvider.GetMonthAsync(_monthReferenceDate);
        await RefreshSelectedCategoryAsync("week", _data.Week);
        await RefreshSelectedCategoryAsync("month", _data.Month);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DataChangeNotifier.Changed -= OnDataChanged;
    }

    private async Task ResetCarryoverAsync(int categoryId, bool startingNextPeriod)
    {
        await SpendingTrackerProvider.ResetCarryoverAsync(categoryId, startingNextPeriod);
        _resettingCategoryId = null;
        _data = await SpendingTrackerProvider.GetSpendingTrackerAsync();
    }

    // Includes the period's own start date - without it, navigating to a different week/month
    // and then re-selecting a category previously viewed elsewhere would show that OTHER
    // period's cached transactions instead of fetching the one actually being looked at.
    private static string TransactionsCacheKey(string idPrefix, int categoryId, DateOnly periodStart) => $"{idPrefix}:{categoryId}:{periodStart}";

    // Lazy-loaded on first click, not fetched up front for every category - most categories
    // are never selected, so eagerly pulling item-level detail for all of them would be
    // wasted work. Cached afterward so switching back to an already-viewed category doesn't
    // re-fetch.
    private async Task SelectCategoryDetailsAsync(string idPrefix, int categoryId, DateOnly periodStart, DateOnly periodEnd)
    {
        if (_selectedCategoryId.GetValueOrDefault(idPrefix) == categoryId)
        {
            _selectedCategoryId[idPrefix] = null;
            return;
        }

        _selectedCategoryId[idPrefix] = categoryId;

        var key = TransactionsCacheKey(idPrefix, categoryId, periodStart);
        if (!_categoryTransactions.ContainsKey(key))
        {
            _categoryTransactions[key] = await SpendingTrackerProvider.GetCategoryTransactionsAsync(categoryId, periodStart, periodEnd);
        }
    }

    // Mirrors Dashboard.razor's own week/month navigation exactly, including going through
    // the same ISpendingTrackerPageProvider.GetWeekAsync/GetMonthAsync calculations - shifts
    // relative to whatever period is currently displayed (its own PeriodStart), not an
    // independently-tracked "today", so repeated Previous/Next clicks stay consistent with
    // what's actually on screen. Current jumps back to the real today instead. Navigating
    // away clears whichever category's transactions were selected on that table - the
    // If a category is currently selected on that table, navigating keeps it selected and
    // re-fetches its transactions for the newly-loaded period instead of clearing the
    // selection - the whole point of Previous/Next here is to keep looking at the same
    // category across periods without re-clicking it every time.
    private async Task PreviousWeekAsync()
    {
        _weekReferenceDate = _weekReferenceDate.AddDays(-7);
        _data!.Week = await SpendingTrackerProvider.GetWeekAsync(_weekReferenceDate);
        await RefreshSelectedCategoryAsync("week", _data.Week);
    }

    private async Task NextWeekAsync()
    {
        _weekReferenceDate = _weekReferenceDate.AddDays(7);
        _data!.Week = await SpendingTrackerProvider.GetWeekAsync(_weekReferenceDate);
        await RefreshSelectedCategoryAsync("week", _data.Week);
    }

    private async Task CurrentWeekAsync()
    {
        _weekReferenceDate = DateOnly.FromDateTime(DateTime.Today);
        _data!.Week = await SpendingTrackerProvider.GetWeekAsync(_weekReferenceDate);
        await RefreshSelectedCategoryAsync("week", _data.Week);
    }

    private async Task PreviousMonthAsync()
    {
        _monthReferenceDate = _monthReferenceDate.AddMonths(-1);
        _data!.Month = await SpendingTrackerProvider.GetMonthAsync(_monthReferenceDate);
        await RefreshSelectedCategoryAsync("month", _data.Month);
    }

    private async Task NextMonthAsync()
    {
        _monthReferenceDate = _monthReferenceDate.AddMonths(1);
        _data!.Month = await SpendingTrackerProvider.GetMonthAsync(_monthReferenceDate);
        await RefreshSelectedCategoryAsync("month", _data.Month);
    }

    private async Task CurrentMonthAsync()
    {
        _monthReferenceDate = DateOnly.FromDateTime(DateTime.Today);
        _data!.Month = await SpendingTrackerProvider.GetMonthAsync(_monthReferenceDate);
        await RefreshSelectedCategoryAsync("month", _data.Month);
    }

    // Keeps whichever category is selected on this table selected across the navigation,
    // fetching (or reusing an already-cached) transaction list for the newly-loaded period -
    // unless that category no longer appears in the new period at all (e.g. it wasn't
    // budgeted yet, or has since been deactivated), in which case there's nothing to show and
    // the selection is cleared instead of pointing at a category that isn't on screen.
    private async Task RefreshSelectedCategoryAsync(string idPrefix, SpendingTrackerResult result)
    {
        if (_selectedCategoryId.GetValueOrDefault(idPrefix) is not { } categoryId)
        {
            return;
        }

        if (!result.Categories.Any(c => c.CategoryId == categoryId))
        {
            _selectedCategoryId[idPrefix] = null;
            return;
        }

        var key = TransactionsCacheKey(idPrefix, categoryId, result.PeriodStart);
        if (!_categoryTransactions.ContainsKey(key))
        {
            _categoryTransactions[key] = await SpendingTrackerProvider.GetCategoryTransactionsAsync(categoryId, result.PeriodStart, result.PeriodEnd);
        }
    }

    private RenderFragment RenderPeriod(string title, string idPrefix, SpendingTrackerResult result, Func<Task> onPrevious, Func<Task> onNext, Func<Task> onCurrent) => @<div style="min-width: 680px;">
        <h2>@title</h2>
        <p>@result.PeriodStart.ToString("yyyy-MM-dd") to @result.PeriodEnd.ToString("yyyy-MM-dd")</p>
        <div style="margin-bottom: 0.5em;">
            <button id="@(idPrefix)-previous" @onclick="onPrevious">&laquo; Previous</button>
            <button id="@(idPrefix)-current" @onclick="onCurrent">Current</button>
            <button id="@(idPrefix)-next" @onclick="onNext">Next &raquo;</button>
        </div>
        <table style="width: 100%;">
            <thead>
                <tr>
                    <th>Category</th>
                    <th class="text-right">Budget</th>
                    <th class="text-right">Spent</th>
                    <th class="text-right">Remaining</th>
                    <th class="text-right">Carried<br />Over</th>
                    <th class="text-right">Net<br />Remaining</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in result.Categories)
                {
                    <tr>
                        <td>
                            <button id="category-link-@idPrefix-@category.CategoryId"
                                    style="background:none; border:none; padding:0; color:#0969da; text-decoration:underline; cursor:pointer; font:inherit;"
                                    @onclick="() => SelectCategoryDetailsAsync(idPrefix, category.CategoryId, result.PeriodStart, result.PeriodEnd)">
                                @category.CategoryName
                            </button>
                        </td>
                        <td class="text-right">@category.Budget.ToString("N2")</td>
                        <td class="text-right">@category.Actual.ToString("N2")</td>
                        <td class="text-right">@category.Remaining.ToString("N2")</td>
                        <td class="text-right">
                            @if (category.IsCarryoverTracked)
                            {
                                <span id="carried-in-@category.CategoryId">@(category.CarriedIn > 0 ? "+" : "")@category.CarriedIn.ToString("N2")</span>
                            }
                        </td>
                        <td class="text-right">
                            @if (category.IsCarryoverTracked)
                            {
                                @((category.RollingBalance ?? category.Remaining).ToString("N2"))
                            }
                        </td>
                        <td style="white-space: nowrap;">
                            @if (category.IsCarryoverTracked)
                            {
                                @if (_resettingCategoryId == category.CategoryId)
                                {
                                    <span id="reset-options-@category.CategoryId" style="font-size:0.85em;">
                                        <button id="reset-this-period-btn-@category.CategoryId" @onclick="() => ResetCarryoverAsync(category.CategoryId, startingNextPeriod: false)">This period</button>
                                        <button id="reset-next-period-btn-@category.CategoryId" @onclick="() => ResetCarryoverAsync(category.CategoryId, startingNextPeriod: true)">Next period</button>
                                        <button id="cancel-reset-btn-@category.CategoryId" @onclick="() => _resettingCategoryId = null">Cancel</button>
                                    </span>
                                }
                                else
                                {
                                    <button id="reset-carryover-btn-@category.CategoryId" style="font-size:0.85em;" @onclick="() => _resettingCategoryId = category.CategoryId">Reset...</button>
                                }
                            }
                            else
                            {
                                <!-- Reserves the same row height as a Reset button would, even though this
                                     category doesn't have one - otherwise This Week and This Month end up
                                     with different row heights for the same categories (whichever ones don't
                                     carry over on that table), and their rows visibly drift out of alignment
                                     down the list. -->
                                <button style="font-size:0.85em; visibility: hidden;" tabindex="-1" aria-hidden="true">Reset...</button>
                            }
                        </td>
                    </tr>
                }
                <tr>
                    <td>Pending / Uncategorized</td>
                    <td></td>
                    <td class="text-right">@result.PendingAmount.ToString("N2")</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
            <tfoot>
                @{
                    var budgetTotal = result.Categories.Sum(c => c.Budget);
                    // Pending is real money already spent, just not yet sorted into a
                    // category - it has to count toward the spent/remaining totals or
                    // this row would overstate how much budget is really left, the exact
                    // kind of "silently ignore uncategorized spend" mistake already fixed
                    // once before for the Amex forecast.
                    var spentTotal = result.Categories.Sum(c => c.Actual) + result.PendingAmount;
                    // Plain Budget-minus-Spent total, with no carryover adjustment - matches
                    // the Remaining column above it, which is likewise carryover-agnostic.
                    var remainingTotal = budgetTotal - spentTotal;
                    var carriedOverTotal = result.Categories.Sum(c => c.CarriedIn);
                    // Sums whatever's actually displayed per row in Net Remaining (the
                    // carryover-adjusted RollingBalance where tracked, plain Remaining
                    // otherwise) rather than Budget-Spent, so the total reconciles with the
                    // column above it.
                    var netRemainingTotal = result.Categories.Sum(c => c.RollingBalance ?? c.Remaining) - result.PendingAmount;
                }
                <tr id="@(idPrefix)-totals-row" style="font-weight: 600; border-top: 2px solid var(--color-border, #ccc)">
                    <td>Total</td>
                    <td class="text-right">@budgetTotal.ToString("N2")</td>
                    <td class="text-right">@spentTotal.ToString("N2")</td>
                    <td class="text-right">@remainingTotal.ToString("N2")</td>
                    <td class="text-right">@carriedOverTotal.ToString("N2")</td>
                    <td class="text-right">@netRemainingTotal.ToString("N2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>

        @if (_selectedCategoryId.GetValueOrDefault(idPrefix) is { } selectedCategoryId)
        {
            var selectedCategoryName = result.Categories.First(c => c.CategoryId == selectedCategoryId).CategoryName;
            <h3 style="margin-top: 1.5em;">@selectedCategoryName transactions</h3>
            @if (!_categoryTransactions.TryGetValue(TransactionsCacheKey(idPrefix, selectedCategoryId, result.PeriodStart), out var lines))
            {
                <p id="category-details-@idPrefix">Loading...</p>
            }
            else if (lines.Count == 0)
            {
                <p id="category-details-@idPrefix">No transactions found for this category in this period.</p>
            }
            else
            {
                <table id="category-details-@idPrefix" style="width: 100%;">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th class="text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in lines)
                        {
                            <tr>
                                <td>@line.Date.ToString("MM/dd/yyyy")</td>
                                <td>@line.Description</td>
                                <td class="text-right">@line.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr id="category-details-@(idPrefix)-total-row" style="font-weight: 600; border-top: 2px solid var(--color-border, #ccc)">
                            <td colspan="2">Total</td>
                            <td class="text-right">@lines.Sum(l => l.Amount).ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            }
        }
    </div>;
}
