@using Expense.Domain.Services.Forecast
@inject IJSRuntime JS
@implements IAsyncDisposable

@{
    var model = _model;
}

@if (model is null)
{
    <p id="cash-flow-chart-empty">No forecast data yet.</p>
}
else
{
    // Everything in this line comes from the fitted trend line, never from comparing the
    // first raw balance to the last one: either of those two endpoints can land anywhere in
    // a pay cycle, so their difference on its own says nothing about direction (a window
    // that happened to start and end on cycle lows once showed a ~$89 raw delta sitting next
    // to a ~$900/yr actual upward trend).
    var trendPerMonth = model.TrendSlopePerDay * 365.25m / 12m;
    var trendChange = model.TrendPoints[^1].Balance - model.TrendPoints[0].Balance;
    var trendSpanMonths = (model.Points[^1].Date.DayNumber - model.Points[0].Date.DayNumber) / (365.25 / 12);
    // "up"/"down" only once the slope is steep enough to mean something - a few dollars a
    // month is regression noise, not a direction worth an arrow.
    var trendWord = Math.Abs(trendPerMonth) < 10m ? "flat" : trendPerMonth > 0m ? "up" : "down";
    var perMonthText = (trendPerMonth >= 0 ? "+" : "") + trendPerMonth.ToString("N0");
    var changeText = (trendChange >= 0 ? "+" : "") + trendChange.ToString("N0");
    var trendSummary = trendWord == "flat"
        ? $"Roughly flat: about {perMonthText}/month"
        : $"Trending {trendWord}: about {perMonthText}/month ({changeText} projected across ~{trendSpanMonths:N0} months)";

    <p id="cash-flow-trend-summary">@trendSummary</p>
    <p>
        <label>
            <input type="checkbox" id="cash-flow-chart-toggle-raw-line" checked="@_showRawLine"
                   @onchange="e => _showRawLine = (bool)e.Value!" />
            Daily balance
        </label>
        <label style="margin-left: 1em;">
            <input type="checkbox" id="cash-flow-chart-toggle-trend-line" checked="@_showTrendLine"
                   @onchange="e => _showTrendLine = (bool)e.Value!" />
            Straight trend
        </label>
        <label style="margin-left: 1em;">
            <input type="checkbox" id="cash-flow-chart-toggle-moving-average" checked="@_showMovingAverage"
                   @onchange="e => _showMovingAverage = (bool)e.Value!" />
            30-day average
        </label>
    </p>
    <svg id="cash-flow-chart-svg" viewBox="0 0 @(model.Width) @(model.Height + 25)" width="100%"
         style="max-width: 100%; border: 1px solid var(--color-text-muted, #64748b); background: var(--color-surface, #fff); box-sizing: border-box; padding: 4px; border-radius: 4px;">
        @foreach (var tick in model.YAxisTicks)
        {
            <line x1="@CashFlowChartBuilder.LeftAxisMargin" y1="@tick.Y" x2="@model.Width" y2="@tick.Y" stroke="#eee" stroke-width="1" />
            @TextElement(CashFlowChartBuilder.LeftAxisMargin - 6, tick.Y + 4, "#666", "end", tick.Label)
        }

        <line x1="@CashFlowChartBuilder.LeftAxisMargin" y1="@model.ZeroLineY" x2="@model.Width" y2="@model.ZeroLineY"
              stroke="#999" stroke-dasharray="4,3" stroke-width="1" />
        @TextElement(CashFlowChartBuilder.LeftAxisMargin - 6, model.ZeroLineY + 4, "#999", "end", "0")

        @foreach (var tick in model.MonthTicks)
        {
            <line x1="@tick.X" y1="0" x2="@tick.X" y2="@model.Height" stroke="#eee" stroke-width="1" />
            @TextElement(tick.X, model.Height + 16, "#666", "middle", tick.Label)
        }

        @if (_showTrendLine)
        {
            <line x1="@model.TrendLineStart.X" y1="@model.TrendLineStart.Y" x2="@model.TrendLineEnd.X" y2="@model.TrendLineEnd.Y"
                  id="cash-flow-chart-trend-line" stroke="#c05621" stroke-width="2" stroke-dasharray="6,3" />
        }

        @if (_showMovingAverage)
        {
            <polyline id="cash-flow-chart-moving-average-line" fill="none" stroke="#2f855a" stroke-width="2"
                      points="@string.Join(" ", model.MovingAveragePoints.Select(p => $"{p.X:F1},{p.Y:F1}"))" />
        }

        @if (_showRawLine)
        {
            <polyline id="cash-flow-chart-line" fill="none" stroke="#8ab4d8" stroke-width="1.25"
                      points="@string.Join(" ", model.Points.Select(p => $"{p.X:F1},{p.Y:F1}"))" />

            @if (model.LowestPoint is { } lowest)
            {
                <circle id="cash-flow-chart-lowest-marker" cx="@lowest.X" cy="@lowest.Y" r="4" fill="#b00020" />
                @TextElement(lowest.X, lowest.Y - 8, "#b00020", model.LowestPointAnchor, $"{lowest.Balance:N2} on {lowest.Date:MM/dd/yyyy}")
            }
        }

        @if (_hoverInfo is { } hover)
        {
            var plotWidth = model.Width - CashFlowChartBuilder.LeftAxisMargin;
            var anchor = (hover.X - CashFlowChartBuilder.LeftAxisMargin) >= plotWidth * 0.85 ? "end"
                : (hover.X - CashFlowChartBuilder.LeftAxisMargin) <= plotWidth * 0.15 ? "start" : "middle";
            var textX = anchor == "end" ? hover.X - 6 : anchor == "start" ? hover.X + 6 : hover.X;

            <g id="cash-flow-chart-hover">
                <line x1="@hover.X" y1="0" x2="@hover.X" y2="@model.Height" stroke="#999" stroke-width="1" stroke-dasharray="2,2" />
                @TextElement(textX, 14, "#333", anchor, hover.Date.ToString("MM/dd/yyyy"))
                @for (var i = 0; i < hover.Lines.Count; i++)
                {
                    var line = hover.Lines[i];
                    @TextElement(textX, 14 + (i + 1) * 14, "#333", anchor, $"{line.Name}: {line.Value:N2}")
                }
            </g>
        }
    </svg>
}

@code {
    [Parameter, EditorRequired]
    public required ForecastResult Forecast { get; set; }

    [Parameter]
    public int Width { get; set; } = 800;

    [Parameter]
    public int Height { get; set; } = 260;

    private bool _showRawLine = true;
    private bool _showTrendLine = true;
    private bool _showMovingAverage = true;

    private CashFlowChartModel? _model;
    private CashFlowChartHoverInfo? _hoverInfo;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CashFlowChart>? _dotNetRef;

    protected override void OnParametersSet()
    {
        _model = Forecast.Rows.Count == 0 ? null : CashFlowChartBuilder.Build(Forecast, Width, Height);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _model is not null)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cashFlowChart.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", "cash-flow-chart-svg", _dotNetRef);
        }
    }

    [JSInvokable]
    public void OnChartHover(double x, double y)
    {
        if (_model is null) return;

        _hoverInfo = CashFlowChartBuilder.GetHoverInfo(_model, x, y, _showRawLine, _showTrendLine, _showMovingAverage);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnChartHoverEnd()
    {
        _hoverInfo = null;
        StateHasChanged();
    }

    // Razor's parser reserves the literal <text>/</text> tag pair for its own "output literal
    // text" directive (case-insensitively), which collides with SVG's <text> element and
    // can't be written directly in markup - emitting it as a raw string sidesteps that entirely.
    private static MarkupString TextElement(double x, double y, string fill, string anchor, string content) =>
        (MarkupString)$"""<text x="{x:F1}" y="{y:F1}" font-size="11" fill="{fill}" text-anchor="{anchor}">{System.Net.WebUtility.HtmlEncode(content)}</text>""";

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detach");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone (e.g. browser closed/navigated away) - nothing to clean up.
            }
        }

        _dotNetRef?.Dispose();
    }
}
